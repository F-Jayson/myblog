API_HOST=127.0.0.1
API_PORT=5180
CLIENT_ORIGIN=http://localhost:5174
API_PROXY_TARGET=http://localhost:5180
VITE_API_ORIGIN=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=jayson_blog
MYSQL_USER=root
MYSQL_PASSWORD=change-this-password
MYSQL_CONNECTION_LIMIT=10
# Optional legacy token. Leave empty to use database administrator accounts only.
ADMIN_API_TOKEN=
ADMIN_DISPLAY_NAME=admin
MONITOR_SLOW_REQUEST_MS=1000
MONITOR_SLOW_SQL_MS=200
# Online compiler sandbox (Docker must be installed on the server)
COMPILER_DOCKER_BIN=docker
COMPILER_DOCKER_NETWORK=none
COMPILER_WORKDIR=.compiler-work
COMPILER_TIMEOUT_MS=20000
COMPILER_MAX_TIMEOUT_MS=30000
COMPILER_MAX_SOURCE_BYTES=262144
COMPILER_MAX_STDIN_BYTES=65536
COMPILER_MAX_CONCURRENT=2
COMPILER_MAX_QUEUED=8
COMPILER_MEMORY_LIMIT=256m
COMPILER_CPU_LIMIT=1
# Offline ip2region xdb files. Defaults to <repo>/data/ip2region/ip2region_v4.xdb and ip2region_v6.xdb.
# IP2REGION_V4_XDB=
# IP2REGION_V6_XDB=

# ==============================================================================
# Storage Configuration / 存储配置 (Cloudflare R2 对象存储 / 本地磁盘存储)
# ==============================================================================
# 存储驱动: local (默认使用本地磁盘 uploads/ 目录) | r2 (使用 Cloudflare R2 对象存储)
STORAGE_DRIVER=local

# Cloudflare R2 配置 (当 STORAGE_DRIVER=r2 时生效)
# 1. R2_ACCOUNT_ID: Cloudflare 仪表盘右侧获取的 Account ID (32位十六进制字符串)
R2_ACCOUNT_ID=
# 2. R2_ACCESS_KEY_ID: 在 Cloudflare 控制台 -> R2 -> Manage R2 API Tokens 中创建的访问密钥 ID
R2_ACCESS_KEY_ID=
# 3. R2_SECRET_ACCESS_KEY: 创建令牌时生成的密钥 Secret
R2_SECRET_ACCESS_KEY=
# 4. R2_BUCKET_NAME: 在 Cloudflare R2 中创建的存储桶名称 (例如: myblog)
R2_BUCKET_NAME=
# 5. R2_PUBLIC_URL: 存储桶绑定的公开访问域名 (例如: https://cdn.yourdomain.com 或 Cloudflare 提供的 https://pub-xxx.r2.dev)
R2_PUBLIC_URL=
# 可选: 自定义 S3 Endpoint (若留空则自动根据 R2_ACCOUNT_ID 生成: https://<account_id>.r2.cloudflarestorage.com)
# R2_ENDPOINT=
# 可选: 区域 (默认 auto)
# R2_REGION=auto
# 可选: 上传到 R2 后是否在本地保留副本 (默认 false)
# R2_KEEP_LOCAL_COPY=false

