{
  "name": "@firefly-rebuild/api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "tsx src/cli.ts migrate",
    "db:seed": "tsx src/cli.ts seed"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "multer": "^2.2.0",
    "mysql2": "^3.14.1",
    "nodemailer": "^9.0.5",
    "zod": "^3.25.17"
  },
  "devDependencies": {
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.1",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.15.21",
    "@types/nodemailer": "^8.0.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
