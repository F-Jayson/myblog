API_PORT=5180
CLIENT_ORIGIN=http://localhost:5174
API_PROXY_TARGET=http://localhost:5180
VITE_API_ORIGIN=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=firefly_blog
MYSQL_USER=firefly
