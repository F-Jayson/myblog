# Online compiler sandbox settings; API runs compiler jobs in Docker containers.
COMPILER_DOCKER_BIN=docker
COMPILER_DOCKER_NETWORK=none
COMPILER_WORKDIR=.compiler-work
COMPILER_TIMEOUT_MS=20000
COMPILER_MAX_TIMEOUT_MS=30000
COMPILER_MAX_CONCURRENT=2
COMPILER_MAX_QUEUED=8
COMPILER_MEMORY_LIMIT=256m
COMPILER_CPU_LIMIT=1
ADMIN_API_TOKEN=change-me
