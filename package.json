{
  "name": "jayson-blog",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @jayson-blog/web --filter @jayson-blog/api dev",
    "build": "pnpm --parallel --filter @jayson-blog/web --filter @jayson-blog/api build",
    "type-check": "pnpm --parallel --filter @jayson-blog/web --filter @jayson-blog/api type-check",
    "db:migrate": "pnpm --filter @jayson-blog/api db:migrate",
    "db:seed": "pnpm --filter @jayson-blog/api db:seed"
  }
}
