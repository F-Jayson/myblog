{
  "name": "jayson-blog",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @jayson-blog/web --filter @jayson-blog/api dev",
    "build": "pnpm --parallel --filter @jayson-blog/web --filter @jayson-blog/api --filter @jayson-blog/mcp --filter @jayson-blog/knowledge-mcp build",
    "type-check": "pnpm --parallel --filter @jayson-blog/web --filter @jayson-blog/api --filter @jayson-blog/mcp --filter @jayson-blog/knowledge-mcp type-check",
    "db:migrate": "pnpm --filter @jayson-blog/api db:migrate",
    "db:seed": "pnpm --filter @jayson-blog/api db:seed",
    "puml:install": "pnpm --filter @jayson-blog/api puml:install",
    "test:puml": "pnpm --filter @jayson-blog/api test:puml",
    "test:github": "pnpm --filter @jayson-blog/api test:github && pnpm --filter @jayson-blog/github-accel test",
    "accel:dev": "pnpm --filter @jayson-blog/github-accel dev",
    "accel:build": "pnpm --filter @jayson-blog/github-accel build",
    "accel:start": "pnpm --filter @jayson-blog/github-accel start"
  }
}
